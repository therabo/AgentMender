{
  "additionalProperties": false,
  "properties": {
    "activity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivityInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Use the activity requested by the user. Omit for broad work."
    },
    "constraints": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchConstraintsInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Only restrictions the user actually requested. An omitted or null field leaves scope unrestricted."
    },
    "coverage_goal": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoverageGoalInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Use exhaustive for requests for complete coverage. The server reports coverage gaps."
    },
    "excluded_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutcomeInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit session-wide outcome exclusion. Verification requires complete logical history."
    },
    "filter": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueryExprInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit Boolean predicate for advanced retrieval. Replaces lexical hints."
    },
    "hints": {
      "$ref": "#/$defs/SearchHintsInput"
    },
    "required_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutcomeInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "A requested result such as implemented, validated, resolved or failed. Omit or use null when unspecified."
    },
    "result_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultPolicyInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Defaults to all_relevant. Use single_best only when explicitly asked to choose one."
    },
    "schema_version": {
      "$ref": "#/$defs/SearchIntentVersion"
    },
    "subject": {
      "description": "The information need, including material scope and qualifications.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "subject",
    "hints"
  ],
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ActivityInput": {
      "enum": [
        "any",
        "discussion",
        "investigation",
        "implementation",
        "testing",
        "validation",
        "decision",
        "troubleshooting"
      ]
    },
    "ArchiveStateInput": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "CalendarRangeInput": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "timezone"
      ],
      "type": "object"
    },
    "CoverageGoalInput": {
      "enum": [
        "standard",
        "exhaustive"
      ]
    },
    "LexicalTerm": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "MembershipBasisInput": {
      "enum": [
        "observed",
        "verified"
      ]
    },
    "MembershipModeInput": {
      "enum": [
        "include",
        "exclude"
      ]
    },
    "OutcomeInput": {
      "enum": [
        "investigated",
        "proposed",
        "attempted",
        "implemented",
        "tested",
        "validated",
        "resolved",
        "reverted",
        "failed",
        "unresolved"
      ]
    },
    "ProjectMembershipInput": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/MembershipBasisInput",
          "description": "Observed means the recorded project label. Verified requires verified membership evidence."
        },
        "mode": {
          "$ref": "#/$defs/MembershipModeInput"
        },
        "names": {
          "items": {
            "$ref": "#/$defs/ProjectName"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "mode",
        "names",
        "basis"
      ],
      "type": "object"
    },
    "ProjectName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "ProjectSourceInput": {
      "enum": [
        "observed_label",
        "verified_label",
        "verified_root"
      ]
    },
    "Provider": {
      "enum": [
        "codex",
        "claude"
      ]
    },
    "QueryExprInput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "$ref": "#/$defs/QueryExprInput"
              },
              "type": "array"
            },
            "op": {
              "const": "and"
            }
          },
          "required": [
            "op",
            "args"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "$ref": "#/$defs/QueryExprInput"
              },
              "type": "array"
            },
            "op": {
              "const": "or"
            }
          },
          "required": [
            "op",
            "args"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "arg": {
              "$ref": "#/$defs/QueryExprInput"
            },
            "op": {
              "const": "not"
            }
          },
          "required": [
            "op",
            "arg"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "provider"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/Provider"
              },
              "type": "array"
            }
          },
          "required": [
            "op",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "project"
            },
            "source": {
              "$ref": "#/$defs/ProjectSourceInput"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "op",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "project_unknown"
            },
            "source": {
              "$ref": "#/$defs/ProjectSourceInput"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "state"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/SessionStateInput"
              },
              "type": "array"
            }
          },
          "required": [
            "op",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "native_id"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "op",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "created"
            },
            "range": {
              "$ref": "#/$defs/QueryRangeInput"
            }
          },
          "required": [
            "op",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "last_active"
            },
            "range": {
              "$ref": "#/$defs/QueryRangeInput"
            }
          },
          "required": [
            "op",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "alternatives": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "$ref": "#/$defs/TextMatchInput"
            },
            "op": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "message_time"
            },
            "range": {
              "$ref": "#/$defs/QueryRangeInput"
            }
          },
          "required": [
            "op",
            "range"
          ],
          "type": "object"
        }
      ]
    },
    "QueryRangeInput": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcRangeInput"
        },
        {
          "$ref": "#/$defs/CalendarRangeInput"
        }
      ]
    },
    "ResultPolicyInput": {
      "enum": [
        "all_relevant",
        "single_best"
      ]
    },
    "SearchConstraintsInput": {
      "additionalProperties": false,
      "properties": {
        "archive_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArchiveStateInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryRangeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "UTC seconds [start,end) or inclusive calendar dates with an IANA timezone."
        },
        "last_active_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryRangeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "UTC seconds [start,end) or inclusive calendar dates with an IANA timezone."
        },
        "native_session_id": {
          "description": "Explicit search target. The server derives the excluded caller separately.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": [
            "string",
            "null"
          ]
        },
        "project_membership": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectMembershipInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ],
          "description": "Target provider within the registered scope."
        }
      },
      "type": "object"
    },
    "SearchHintsInput": {
      "additionalProperties": false,
      "properties": {
        "project_names": {
          "description": "Topical project names for assessment. They do not constrain stored membership.",
          "items": {
            "$ref": "#/$defs/ProjectName"
          },
          "maxItems": 4,
          "type": "array"
        },
        "terms": {
          "description": "One or a few distinctive content terms or phrases. Each term can independently retrieve a candidate.",
          "items": {
            "$ref": "#/$defs/LexicalTerm"
          },
          "maxItems": 8,
          "type": "array"
        }
      },
      "required": [
        "terms"
      ],
      "type": "object"
    },
    "SearchIntentVersion": {
      "enum": [
        "1"
      ]
    },
    "SessionStateInput": {
      "enum": [
        "active",
        "archived",
        "unknown"
      ]
    },
    "TextMatchInput": {
      "enum": [
        "contains",
        "phrase",
        "exact"
      ]
    },
    "UtcRangeInput": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "start": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  }
}
